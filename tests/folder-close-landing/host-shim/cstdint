#pragma once
// Freestanding host build (run.py passes -nostdinc++ and links lld/msvcrt directly),
// targeting the MSVC x64 ABI. The widths below are the ones that ABI fixes; nothing
// here is a guess about the production build, which uses the real <cstdint>.
using int8_t = signed char;
using int16_t = short;
using int32_t = int;
using int64_t = long long;
using uint8_t = unsigned char;
using uint16_t = unsigned short;
using uint32_t = unsigned int;
using uint64_t = unsigned long long;
using intptr_t = long long;
using uintptr_t = unsigned long long;
