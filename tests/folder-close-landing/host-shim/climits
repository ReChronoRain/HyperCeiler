#pragma once
// Freestanding host build (run.py passes -nostdinc++). home_drop_geometry.h includes
// <climits> for integer-limit spellings; nothing in it currently reads one, but an empty
// header would let a future use compile against nothing. The values are the MSVC x64 ABI
// widths the host objects are compiled for, so INT_MAX here is the real 2147483647 rather
// than a placeholder that silently changes overflow behaviour in a bounds check.
#define CHAR_BIT 8
#define SCHAR_MIN (-128)
#define SCHAR_MAX 127
#define UCHAR_MAX 255
#define CHAR_MIN SCHAR_MIN
#define CHAR_MAX SCHAR_MAX
#define MB_LEN_MAX 1
#define SHRT_MIN (-32768)
#define SHRT_MAX 32767
#define USHRT_MAX 65535
#define INT_MIN (-2147483647 - 1)
#define INT_MAX 2147483647
#define UINT_MAX 4294967295u
#define LONG_MIN (-9223372036854775807LL - 1)
#define LONG_MAX 9223372036854775807LL
#define ULONG_MAX 18446744073709551615ULL
#define LLONG_MIN (-9223372036854775807LL - 1)
#define LLONG_MAX 9223372036854775807LL
#define ULLONG_MAX 18446744073709551615ULL
